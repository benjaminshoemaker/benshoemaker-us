---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/site';

const areas = [
  {
    title: 'Product direction and early development',
    situation: 'You have an idea, but the first useful version is still unclear.',
    description: "I can help figure out who it's for, what problem is worth solving, and what would make someone choose it. From there, we can build a prototype, get feedback, and decide what to take further. The scope often gets smaller as we understand the problem better.",
  },
  {
    title: 'AI product quality',
    situation: 'The demo works. Everyday use is more complicated.',
    description: "I work through the failures people actually encounter: repetitive answers, missing context, confusing handoffs, or an AI saying it changed something when it didn't. We can define what good behavior looks like, test changes, and trace the problem through the product. Sometimes the fix is in a prompt. Sometimes it's elsewhere in the application.",
  },
  {
    title: 'AI in the way your team works',
    situation: 'You want to get beyond individual experiments with AI tools.',
    description: "I can work with your team on coding workflows, internal tools, and agents that fit the work you're already doing. That includes deciding what to automate, where someone should review the result, and how we'll know whether the change is useful. I use these tools directly and build alongside the team.",
  },
  {
    title: 'Measurement and product decisions',
    situation: 'You have data, but it still feels hard to make a decision.',
    description: "I've spent years on this problem, from company-wide metrics at Indeed to early product funnels. I can help define what matters, check what the data actually measures, and connect it with customer feedback. That might mean fixing instrumentation, simplifying a dashboard, or changing the question we're asking.",
  },
];
---

<BaseLayout title="Working together" description="Work with Ben Shoemaker on product direction, AI quality, team workflows, and measurement.">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <header class="max-w-[68ch] mb-12">
      <h1 class="text-3xl sm:text-4xl font-bold text-text-primary mb-5">Working together</h1>
      <p class="text-xl leading-relaxed text-text-primary">I work with founders and product teams on what to build, how to build it, and how to tell whether it's working.</p>
      <p class="text-lg leading-relaxed mt-4">I spent years on employer products and data platforms at Indeed. More recently, I've worked on AI products in small teams and built projects of my own. I can help think through the direction, get into the details, and build things with you.</p>
    </header>

    <section aria-labelledby="where-i-help">
      <h2 id="where-i-help" class="text-2xl font-semibold text-text-primary mb-6">Where I can help</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {areas.map(area => (
          <article class="p-6 sm:p-8 bg-surface-raised border border-border rounded-xl">
            <h3 class="text-xl font-semibold text-text-primary mb-3">{area.title}</h3>
            <p class="text-base text-accent-text mb-4">{area.situation}</p>
            <p class="text-text-body leading-relaxed">{area.description}</p>
          </article>
        ))}
      </div>
    </section>

    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] gap-10 lg:gap-16 mt-14 pt-10 border-t border-border">
      <section aria-labelledby="start" class="max-w-[68ch]">
        <h2 id="start" class="text-2xl font-semibold text-text-primary mb-4">How we'd start</h2>
        <div class="space-y-4 text-lg leading-relaxed">
          <p>I'd want to see what you're working on, who's using it, and where you're stuck. We should be able to name a decision to make or something useful to try before we turn it into a bigger project.</p>
          <p>From there, we can work out where I can contribute: advising on a specific problem, building a prototype or tool, or taking on a broader piece of product work with your team.</p>
        </div>
      </section>
      <aside aria-labelledby="explore">
        <h2 id="explore" class="text-xl font-semibold text-text-primary mb-4">A feel for my work</h2>
        <ul class="space-y-4 text-base">
          <li><a href="/projects#vibescaffold" class="text-accent hover:underline">VibeScaffold &rarr;</a><p class="text-sm text-text-muted mt-1">From a product idea to a specification.</p></li>
          <li><a href="/writing/product-builder-role" class="text-accent hover:underline">The AI Builder &rarr;</a><p class="text-sm text-text-muted mt-1">My thinking on product work and building.</p></li>
          <li><a href="/about" class="text-accent hover:underline">More about my background &rarr;</a></li>
        </ul>
      </aside>
    </div>

    <section aria-labelledby="contact" class="mt-12 rounded-2xl bg-accent-light border border-accent/20 p-6 sm:p-8">
      <h2 id="contact" class="text-2xl font-semibold text-text-primary mb-3">What are you working on?</h2>
      <p class="text-text-body mb-6 max-w-prose leading-relaxed">Send me a little context about the problem and where you'd like help. We can start there.</p>
      <div class="flex flex-wrap gap-3">
        <a href={`mailto:${siteConfig.author.email}`} class="inline-flex items-center justify-center px-6 py-3 bg-accent text-white font-medium rounded-lg hover:bg-accent-hover transition-colors">Send an email</a>
        <a href={siteConfig.author.calendarUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-6 py-3 border border-border bg-surface-raised text-text-primary font-medium rounded-lg hover:bg-white transition-colors">Book a call</a>
      </div>
    </section>
  </div>
</BaseLayout>
